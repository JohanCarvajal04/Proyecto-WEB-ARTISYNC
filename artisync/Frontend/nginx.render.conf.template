server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # BACKEND_INTERNAL_URL debe ser el origen del backend sin barra final,
    # p.ej. https://artisync-backend.onrender.com — al no tener path, nginx
    # reenvia la URI original completa (/api/..., /actuator/..., /ws/...).
    location /api {
        proxy_pass ${BACKEND_INTERNAL_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /actuator {
        proxy_pass ${BACKEND_INTERNAL_URL};
        proxy_ssl_server_name on;
    }

    location /ws {
        proxy_pass ${BACKEND_INTERNAL_URL};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
