# Copiar este archivo a .env y completar valores reales (.env NUNCA se sube a Git)

# ==========================================
# Base de datos (Azure PostgreSQL)
# ==========================================
# Los servicios corren en Docker, pero la base de datos esta en Azure.
DB_NAME=artisyncbd
DB_URL=jdbc:postgresql://tu-servidor.postgres.database.azure.com:5432/artisyncbd?sslmode=require
# DB_USER/DB_PASSWORD: cuenta admin de Azure, usada por Flyway para
# crear/migrar tablas (DDL) y gestionar flyway_schema_history.
DB_USER=cambiar_usuario_admin
DB_PASSWORD=cambiar_contrasena_admin
# DB_APP_USER/DB_APP_PASSWORD: cuenta de privilegios minimos (artisync_app)
# que usa Hibernate/JPA en tiempo de ejecucion. Solo tiene permisos de
# SELECT, INSERT, UPDATE, DELETE (sin DDL). Creada manualmente en Azure
# con los scripts de db/seed_privilegios.sh o la guia de roles.
DB_APP_USER=artisync_app
# IMPORTANTE: Si la contraseña contiene un signo de dólar ($) (ej: App$ecure),
# DEBE escaparse con doble dólar ($$) para que Docker Compose no lo confunda
# con una variable de entorno. Ejemplo: App$$ecure2026!
DB_APP_PASSWORD=cambiar_contrasena_app

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# TTL del caché del catálogo en segundos (ADR-004). Opcional: 60 por defecto.
CATALOGO_CACHE_TTL=60

# ==========================================
# JWT (Clave secreta HS256 generada en hex)
# Generar con: openssl rand -hex 32
# ==========================================
JWT_SECRET=cambiar_generar_con_openssl_rand_hex_32
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ==========================================
# Cookies y proxy de confianza (OBS-AUTO-06 / A07 OWASP)
# ==========================================
# true en produccion (HTTPS) para que la cookie httpOnly de refresh/2FA lleve
# el atributo Secure. En false para desarrollo local sin TLS.
APP_COOKIE_SECURE=false
# Regex de proxies internos de confianza para server.tomcat.remoteip.internal-proxies
# (application.properties). Vacio = usa el default (rangos privados RFC1918 +
# loopback), suficiente para la red interna de docker-compose. Solo hace falta
# fijarlo si el backend se despliega detras de un proxy adicional fuera de esos
# rangos.
TRUSTED_PROXY_CIDR=

# ==========================================
# Correo electrónico (SMTP)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion

# ==========================================
# Frontend
# ==========================================
FRONTEND_URL=http://localhost:4200

# ==========================================
# CONFIGURACIÓN DE INTELIGENCIA ARTIFICIAL
# ==========================================
# `mock` es el valor de la plantilla a propósito: arranca sin credenciales.
# Cámbialo a `gemini` o `nvidia` en tu .env cuando tengas la API key.
IA_PROVIDER=mock
IA_CONFIDENCE_THRESHOLD=0.75
IA_TIMEOUT=30
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=nvidia/llama-3.2-nv-vision-instruct
GEMINI_API_KEY=su_api_key
GEMINI_MODEL=gemini-2.0-flash

# `local` guarda los archivos subidos (cédulas, títulos) en DOCUMENTOS_RUTA_BASE.
# `azure` los sube a Azure Blob Storage usando las variables AZURE_STORAGE_* de abajo.
DOCUMENTOS_PROVEEDOR=local
DOCUMENTOS_RUTA_BASE=/var/artisync/documentos


# Solo se leen con DOCUMENTOS_PROVEEDOR=azure.
# El contenedor debe crearse PRIVADO: guarda cédulas y títulos. Nunca se sirve
# una URL directa, se firma un SAS de vigencia corta.
# Para desarrollo con el emulador Azurite (docker compose up azurite), usar:
#   AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=artisync
AZURE_STORAGE_SAS_MINUTOS=15

# Techo global de subida. Verificación aplica su propio límite de 5MB aparte.
MULTIPART_MAX_FILE_SIZE=100MB
MULTIPART_MAX_REQUEST_SIZE=100MB

# ==============================
# PayPal (RF-20) — pagos en garantía
# ==============================
# Credenciales de la app en developer.paypal.com. Con PAYPAL_MODE=sandbox se
# usa api-m.sandbox.paypal.com; cualquier otro valor apunta a producción.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Id del webhook registrado en PayPal, necesario para verificar la firma de las
# notificaciones (RNF-14). El endpoint /api/webhooks/paypal es público, así que
# esa verificación es lo único que impide que un POST falsificado marque un
# pedido como pagado. Sin este valor el backend rechaza TODOS los webhooks.
# En desarrollo hace falta exponer el backend (ngrok) y registrar allí la URL.
PAYPAL_WEBHOOK_ID=
