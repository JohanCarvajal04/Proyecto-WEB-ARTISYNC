# Copiar este archivo a .env y completar valores reales (.env NUNCA se sube a Git)

# ==========================================
# Base de datos (PostgreSQL)
# ==========================================
DB_NAME=artisyncbd
DB_URL=jdbc:postgresql://localhost:5432/artisyncbd
# DB_USER/DB_PASSWORD: superusuario del contenedor postgres; usado solo para
# inicializar el volumen y por Flyway para gestionar flyway_schema_history.
DB_USER=postgres
DB_PASSWORD=changeme
# DB_APP_PASSWORD: contrasena de la cuenta de aplicacion de privilegios
# minimos (artisync_app, A.2.3) que usa Hibernate/JPA en tiempo de ejecucion.
# Se crea automaticamente en el primer arranque via db/seed_privilegios.sh.
DB_APP_PASSWORD=changeme_app

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# JWT (Clave secreta HS256 generada en hex)
# Generar con: openssl rand -hex 32
# ==========================================
JWT_SECRET=f98cf546c1a89c93f0b2f1559868779b76c8c4a4f89d0b676a74c431d1d8ef3f
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ==========================================
# Correo electrónico (SMTP)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion

# ==========================================
# Frontend
# ==========================================
FRONTEND_URL=http://localhost:4200

# ==========================================
# CONFIGURACIÓN DE INTELIGENCIA ARTIFICIAL
# ==========================================
IA_PROVIDER=mock
IA_CONFIDENCE_THRESHOLD=0.75
IA_TIMEOUT=30
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=nvidia/llama-3.2-nv-vision-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

DOCUMENTOS_RUTA_BASE=/var/artisync/documentos
